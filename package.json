{
  "name": "@ffy6511/kago",
  "version": "0.1.0",
  "description": "Kago — agent skills tailored to each project, powered by Magpie",
  "type": "module",
  "main": "./index.mjs",
  "bin": {
    "kago": "./cli.mjs"
  },
  "files": [
    "index.mjs",
    "cli.mjs",
    "src",
    "page",
    "ui",
    "docs",
    "README.md",
    "README-zh.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "start": "node cli.mjs serve",
    "check": "node --check index.mjs && node --check cli.mjs && node --check ui/app.js && node --check ui/native-ui.js && node --check ui/skill-reader.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "magpie": {
    "summary": {
      "en": "Deploy categorized skills to projects from a Git-tracked manifest",
      "zh": "从分类技能库和项目清单同步项目级技能"
    },
    "page": {
      "title": "Kago",
      "titles": {
        "zh": "Kago"
      },
      "file": "page/index.html",
      "icon": "page/kago-icon.png",
      "service": {
        "port": 3498,
        "option": "port"
      }
    },
    "options": {
      "port": 3498
    }
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffy6511/Kago.git"
  }
}
