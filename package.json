{
  "name": "@ffy6511/magpie-skill-workspaces",
  "version": "0.1.0",
  "description": "Categorized skill libraries and manifest-driven project workspaces for Magpie",
  "type": "module",
  "main": "./index.mjs",
  "bin": {
    "skill-workspaces": "./cli.mjs"
  },
  "files": [
    "index.mjs",
    "cli.mjs",
    "src",
    "page",
    "ui",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "start": "node cli.mjs serve",
    "check": "node --check index.mjs && node --check cli.mjs && node --check ui/app.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "magpie": {
    "summary": {
      "en": "Deploy categorized skills to projects from a Git-tracked manifest",
      "zh": "\u4ece\u5206\u7c7b\u6280\u80fd\u5e93\u548c\u9879\u76ee\u6e05\u5355\u540c\u6b65\u9879\u76ee\u7ea7\u6280\u80fd"
    },
    "page": {
      "title": "Skill Workspaces",
      "titles": {
        "zh": "\u6280\u80fd\u5de5\u4f5c\u533a"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3498,
        "option": "port"
      }
    },
    "options": {
      "port": 3498
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffy6511/magpie-skill-workspaces.git"
  }
}
